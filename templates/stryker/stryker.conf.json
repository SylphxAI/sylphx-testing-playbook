{
	"$schema": "https://unpkg.com/@stryker-mutator/core/schema/stryker-schema.json",
	"_comment": "Mutation testing config — targets pure testable modules only. Adapt `mutate` and `commandRunner.command` to your project.",
	"packageManager": "npm",
	"testRunner": "command",
	"commandRunner": {
		"command": "bun test src/**/*.test.ts"
	},
	"mutate": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"!src/**/*.d.ts",
		"!src/**/index.ts"
	],
	"reporters": ["clear-text", "html", "progress"],
	"htmlReporter": {
		"fileName": "mutation-report/index.html"
	},
	"thresholds": {
		"high": 85,
		"low": 70,
		"break": 60
	},
	"timeoutMS": 30000,
	"timeoutFactor": 2,
	"concurrency": 4,
	"tempDirName": ".stryker-tmp",
	"cleanTempDir": true,
	"disableTypeChecks": "{src,test}/**/*.{ts,tsx}"
}
